{% extends 'base.html.twig' %}

{% block title %}Signature de PDF{% endblock %}

{% block javascripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" defer></script>
    <script src="{{ asset('js/signature.js') }}" defer></script>
{% endblock %}

{% block body %}
    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-8">
        <section class="mb-8 rounded-3xl border border-slate-800 bg-slate-900/70 p-6 shadow-2xl shadow-cyan-900/20">
            <p class="text-sm uppercase tracking-[0.35em] text-cyan-300">Symfony + Tailwind</p>
            <h1 class="mt-3 text-3xl font-bold text-white sm:text-4xl">Signer un PDF en ligne</h1>
            <p class="mt-3 max-w-3xl text-slate-300">
                Upload ton PDF, previsualise-le, puis ajoute ta signature en dessin, image ou texte style signature.
            </p>
        </section>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 rounded-2xl border px-4 py-3 text-sm {{ type == 'error' ? 'border-rose-400/40 bg-rose-400/10 text-rose-100' : 'border-emerald-400/40 bg-emerald-400/10 text-emerald-100' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if not hasUploadedPdf %}
            <section class="mx-auto max-w-2xl rounded-3xl border border-slate-800 bg-slate-900 p-6">
                <h2 class="text-xl font-semibold text-white">1) Importer un PDF</h2>
                <form action="{{ path('app_pdf_sign_upload') }}" method="post" enctype="multipart/form-data" class="mt-5 space-y-5">
                    <label for="pdfFile" class="block text-sm font-medium text-slate-200">Fichier PDF (max 15 Mo)</label>
                    <input
                        id="pdfFile"
                        name="pdfFile"
                        required
                        type="file"
                        accept="application/pdf"
                        class="block w-full rounded-xl border border-slate-700 bg-slate-950/70 p-3 text-sm text-slate-100 file:mr-4 file:rounded-lg file:border-0 file:bg-cyan-500/20 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-cyan-100 hover:file:bg-cyan-500/30"
                    >
                    <button type="submit" class="inline-flex items-center rounded-xl bg-cyan-500 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-400">
                        Continuer vers la signature
                    </button>
                </form>
            </section>
        {% else %}
            <div class="grid gap-6 xl:grid-cols-2">
                <section class="rounded-3xl border border-slate-800 bg-slate-900 p-5">
                    <div class="mb-4 flex items-center justify-between gap-3">
                        <h2 class="text-lg font-semibold text-white">2) Previsualisation</h2>
                        <span class="max-w-[60%] truncate rounded-lg bg-slate-800 px-3 py-1 text-xs text-slate-300">{{ originalName }}</span>
                    </div>
                    <p class="mb-3 text-sm text-slate-300">Clique pour placer ta signature. Tu peux la deplacer et la redimensionner avec la poignee.</p>
                    <div id="pdfStage" data-pdf-url="{{ path('app_pdf_sign_preview') }}" class="relative overflow-hidden rounded-2xl border border-slate-700 bg-slate-950">
                        <canvas id="pdfCanvas" class="w-full"></canvas>

                        <div id="signatureOverlay" class="absolute hidden select-none touch-none cursor-move border-2 border-cyan-300/80 bg-white/90 shadow-lg">
                            <img id="overlaySignatureImage" alt="Signature positionnee" class="h-full w-full object-contain">
                            <div id="signatureResizeHandle" class="absolute -bottom-2 -right-2 h-5 w-5 cursor-nwse-resize rounded-full border border-cyan-100 bg-cyan-400 shadow"></div>
                        </div>
                    </div>
                    <div class="mt-3 flex items-center justify-between rounded-xl border border-slate-700 bg-slate-950/70 px-3 py-2 text-sm text-slate-300">
                        <button type="button" id="prevPageButton" class="rounded-lg border border-slate-600 px-3 py-1 text-xs font-semibold hover:bg-slate-800">Page precedente</button>
                        <span id="pageInfoLabel">Page 1 / 1</span>
                        <button type="button" id="nextPageButton" class="rounded-lg border border-slate-600 px-3 py-1 text-xs font-semibold hover:bg-slate-800">Page suivante</button>
                    </div>
                </section>

                <section class="rounded-3xl border border-slate-800 bg-slate-900 p-5">
                    <h2 class="text-lg font-semibold text-white">3) Signature</h2>
                    <p class="mt-1 text-sm text-slate-300">Choisis une methode puis place la signature sur la premiere ou derniere page.</p>

                    <form id="signForm" action="{{ path('app_pdf_sign_sign') }}" method="post" class="mt-5 space-y-5">
                        <input type="hidden" id="signatureData" name="signatureData">
                        <input type="hidden" id="pageNumber" name="pageNumber" value="1">
                        <input type="hidden" id="xRatio" name="xRatio" value="0.65">
                        <input type="hidden" id="yRatio" name="yRatio" value="0.75">
                        <input type="hidden" id="widthRatio" name="widthRatio" value="0.3">

                        <div class="grid grid-cols-3 gap-2 rounded-xl bg-slate-950 p-2">
                            <button type="button" data-sign-mode="draw" class="sign-mode-btn rounded-lg bg-cyan-500/20 px-3 py-2 text-sm font-medium text-cyan-100">Dessin</button>
                            <button type="button" data-sign-mode="image" class="sign-mode-btn rounded-lg px-3 py-2 text-sm font-medium text-slate-300">Image</button>
                            <button type="button" data-sign-mode="text" class="sign-mode-btn rounded-lg px-3 py-2 text-sm font-medium text-slate-300">Texte</button>
                        </div>

                        <div id="panel-draw" class="sign-panel rounded-2xl border border-slate-700 p-4">
                            <p class="mb-3 text-sm text-slate-300">Dessine ta signature ci-dessous:</p>
                            <canvas id="drawCanvas" width="520" height="180" class="w-full rounded-xl border border-slate-600 bg-white"></canvas>
                            <button type="button" id="clearDrawCanvas" class="mt-3 rounded-lg border border-slate-600 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-slate-800">
                                Effacer
                            </button>
                        </div>

                        <div id="panel-image" class="sign-panel hidden rounded-2xl border border-slate-700 p-4">
                            <label for="signatureImage" class="block text-sm font-medium text-slate-200">Importer une image de signature</label>
                            <input
                                id="signatureImage"
                                type="file"
                                accept="image/png,image/jpeg,image/jpg"
                                class="mt-3 block w-full rounded-xl border border-slate-700 bg-slate-950/70 p-3 text-sm text-slate-100 file:mr-4 file:rounded-lg file:border-0 file:bg-cyan-500/20 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-cyan-100"
                            >
                            <img id="signatureImagePreview" alt="Signature importee" class="mt-4 hidden max-h-40 rounded-lg border border-slate-700 bg-white p-2">
                        </div>

                        <div id="panel-text" class="sign-panel hidden rounded-2xl border border-slate-700 p-4">
                            <label for="signatureText" class="block text-sm font-medium text-slate-200">Tape ton nom (style signature)</label>
                            <input
                                id="signatureText"
                                type="text"
                                placeholder="Ex: Marie Dupont"
                                class="mt-3 w-full rounded-xl border border-slate-700 bg-slate-950/70 px-4 py-3 text-base text-white outline-none ring-cyan-400 transition focus:ring"
                            >
                            <p id="textSignaturePreview" class="mt-4 text-3xl text-white" style="font-family: 'Pacifico', cursive;"></p>
                        </div>

                        <p class="rounded-xl border border-cyan-500/30 bg-cyan-500/10 px-4 py-3 text-sm text-cyan-100">
                            Place et redimensionne ta signature directement dans la preview a gauche.
                        </p>

                        <div class="rounded-2xl border border-slate-700 bg-slate-950/70 p-4">
                            <p class="mb-2 text-xs uppercase tracking-wider text-slate-400">Apercu de la signature appliquee</p>
                            <img id="signatureLivePreview" alt="Apercu signature" class="hidden max-h-28 rounded-lg border border-slate-600 bg-white p-2">
                            <p id="signaturePlaceholder" class="text-sm text-slate-400">L'apercu apparaitra ici apres preparation.</p>
                        </div>

                        <button type="submit" class="inline-flex items-center rounded-xl bg-emerald-400 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-300">
                            Generer le PDF signe
                        </button>
                    </form>

                    <form action="{{ path('app_pdf_sign_reset') }}" method="post" class="mt-4">
                        <button type="submit" class="rounded-xl border border-slate-600 px-4 py-2 text-xs font-semibold text-slate-200 hover:bg-slate-800">
                            Changer de document
                        </button>
                    </form>
                </section>
            </div>
        {% endif %}
    </main>
{% endblock %}
